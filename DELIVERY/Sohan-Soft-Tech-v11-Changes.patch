+        [device.id, data.eventId],
+      );
+      if (retry?.payload_hash === hash)
+        return { attendanceId: retry.id, duplicate: true };
+      throw e;
+    }
+    return { attendanceId: id, chargedPaise: charged, duplicate: false };
+  });
+}
