+import { toast } from "sonner";
+export function HardwareSettings() {
+  const { request, query, refresh } = useApp(),
+    r = useResource("hardware"),
+    [name, setName] = useState(""),
+    [device, setDevice] = useState<{
+      id: string;
+      secret: string;
+      endpoint: string;
